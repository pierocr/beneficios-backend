PORT=3000
NODE_ENV=development
PLAYWRIGHT_HEADLESS=true
APP_TIMEZONE=America/Santiago
PERSIST_RESULTS_TO_DB=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_DASHBOARD_TOKEN=change-this-local-secret
PUBLIC_SCRAPE_TOKEN=change-this-if-you-enable-raw-scraping
CACHE_BENEFIT_IMAGES=false
BENEFIT_IMAGES_BUCKET=benefit-images
BENEFIT_IMAGE_MAX_WIDTH=800
BENEFIT_IMAGE_WEBP_QUALITY=72
BENEFIT_IMAGE_DOWNLOAD_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Alternative if you later choose direct Postgres tools:
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
